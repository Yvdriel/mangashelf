# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/config

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/

# e2e
/.test-data/
/test-results/
/playwright-report/
/playwright/.cache/
/playwright/.auth/
/.playwright-mcp/

# media
/media
/downloads

# locally-fetched dictionary files (bundled in Docker, dev-only here)
/var/

# android (Kotlin/Gradle native client)
/android/.gradle/
/android/build/
/android/captures/
/android/local.properties
/android/.idea/
/android/*.iml
/android/app/build/
/android/dict/*/build/

# dict bake (CH.2): raw source banks + baked output — large, never committed.
# The bake-db TOOL source IS committed; only data + build output are ignored.
/tools/dict-data/
/tools/bake-db/out/
